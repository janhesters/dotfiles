#!/bin/bash
#
# Toggle screen recording of the Elgato Prompter (teleprompter) monitor, with an
# audio-source menu mirroring omarchy's Super+Ctrl+C screenrecord options.
#
# Why this exists instead of Omarchy's screen recorder: the Elgato Prompter
# is a DisplayLink/evdi *virtual* display. gpu-screen-recorder can't capture it —
# its kms backend can't see evdi outputs ("display not found"), and its portal
# backend fails the EGL DMA-BUF modifier import on this AMD box. wf-recorder uses
# the wlr-screencopy protocol + software (libx264) encoding, which works. Keep
# using Super+Ctrl+C for the two real monitors; use this for the teleprompter.
#
# A background watchdog guards against the dock's USB dropping mid-recording
# (2026-07-02: the CalDigit TS4 hub re-enumerated 5s into a take; Hyprland
# destroyed the evdi output and wf-recorder silently recorded 34 min of nothing).
# If the prompter output vanishes, the watchdog finalizes the current segment,
# resumes into a new one as soon as the display returns, and on stop the segments
# are stitched into ONE continuous video: the gap is filled with the frozen last
# frame + silence, so the video freezes over the drop and then keeps going.

notify() {
  local glyph=$1
  shift
  omarchy notification send -g "$glyph" "$@"
}

# Keep session state private to this login. Besides avoiding cross-user clashes,
# XDG_RUNTIME_DIR is cleared when the user session ends, so stale PID files do
# not survive a reboot and later point at recycled processes.
if [[ -z ${XDG_RUNTIME_DIR:-} || ! -d $XDG_RUNTIME_DIR || ! -O $XDG_RUNTIME_DIR ]]; then
  notify "󰕧" "Teleprompter recording unavailable" "XDG_RUNTIME_DIR is missing or not owned by this user" -u critical
  exit 1
fi

RUNTIME_DIR="$XDG_RUNTIME_DIR/record-teleprompter"
if [[ -L $RUNTIME_DIR ]]; then
  notify "󰕧" "Teleprompter recording unavailable" "$RUNTIME_DIR must not be a symlink" -u critical
  exit 1
fi
mkdir -p -- "$RUNTIME_DIR" || exit 1
chmod 700 -- "$RUNTIME_DIR" || exit 1

STATE="$RUNTIME_DIR/audio-modules"       # PipeWire module IDs to tear down on stop
WATCHDOG="$RUNTIME_DIR/watchdog.pid"     # watchdog PID, killed on toggle-stop
RECORDER="$RUNTIME_DIR/recorder.pid"     # owned wf-recorder PID + session token
WAITING="$RUNTIME_DIR/waiting"           # exists while waiting for the prompter to reconnect
SEGMENTS="$RUNTIME_DIR/segments"         # files of the current session, in order
LOG="$RUNTIME_DIR/wf-recorder.log"

teardown_audio() {
  if [[ -f $STATE ]]; then
    while read -r id; do [[ -n $id ]] && pactl unload-module "$id" 2>/dev/null; done <"$STATE"
    rm -f "$STATE"
  fi
}

# The evdi connector name (e.g. DVI-I-2) can change across reconnects, so always
# resolve the output by description (monitors.lua matches the same way).
find_output() {
  hyprctl monitors -j | jq -r '.[] | select(.description | test("Elgato Prom")) | .name' | head -1
}

# Is the recorded watchdog PID alive and actually one of ours? Guards against a
# stale pidfile after a crash pointing at some unrelated recycled PID.
watchdog_alive() {
  local pid
  [[ -f $WATCHDOG ]] && pid=$(<"$WATCHDOG") || return 1
  [[ $pid =~ ^[0-9]+$ && -d /proc/$pid && -O /proc/$pid ]] \
    && grep -aq record-teleprompter "/proc/$pid/cmdline" 2>/dev/null
}

# Match the recorder by both its PID and a private token injected into the
# process environment. A stale PID file therefore cannot make us signal an
# unrelated wf-recorder after Linux recycles the PID.
recorder_process_matches() {
  local pid=$1 session=$2 comm
  [[ $pid =~ ^[0-9]+$ && $session =~ ^[[:alnum:]-]+$ ]] || return 1
  [[ -d /proc/$pid && -O /proc/$pid ]] || return 1
  read -r comm <"/proc/$pid/comm" 2>/dev/null || return 1
  [[ $comm == wf-recorder ]] || return 1
  grep -Fzqx -- "RECORD_TELEPROMPTER_SESSION=$session" "/proc/$pid/environ" 2>/dev/null
}

recorder_alive() {
  local pid session
  [[ -f $RECORDER ]] && read -r pid session <"$RECORDER" || return 1
  recorder_process_matches "$pid" "$session"
}

# Stop wf-recorder and make sure it is actually gone. SIGINT lets it write the
# moov atom so the mp4 is seekable — but with --audio it then routinely hangs on
# exit (encoder done, file closed, process ignores SIGTERM). So: SIGINT, wait,
# and once it has closed the mp4 (finalized, nothing left to lose) force-kill.
stop_recorder() {
  local pid session
  if ! [[ -f $RECORDER ]] || ! read -r pid session <"$RECORDER" \
    || ! recorder_process_matches "$pid" "$session"; then
    rm -f -- "$RECORDER"
    return 0
  fi

  kill -INT "$pid" 2>/dev/null
  for _ in $(seq 1 50); do
    if ! recorder_process_matches "$pid" "$session"; then
      rm -f -- "$RECORDER"
      return 0
    fi
    sleep 0.1
  done
  for _ in $(seq 1 100); do
    recorder_process_matches "$pid" "$session" || break
    readlink "/proc/$pid"/fd/* 2>/dev/null | grep -q '\.mp4$' || break
    sleep 0.1
  done
  recorder_process_matches "$pid" "$session" && kill -KILL "$pid" 2>/dev/null
  for _ in $(seq 1 10); do
    recorder_process_matches "$pid" "$session" || break
    sleep 0.1
  done
  rm -f -- "$RECORDER"
}

# Start a new recording segment on output $1; sets FILE. audio_args must be set.
start_recorder() {
  local pid
  FILE="$OUTPUT_DIR/teleprompter-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  if [[ -z ${SESSION_ID:-} ]]; then
    read -r SESSION_ID </proc/sys/kernel/random/uuid || return 1
  fi
  # -r 30 forces constant 30fps; wf-recorder is damage-based, so a static/paused
  # teleprompter screen would otherwise emit almost no frames (zero-duration clip).
  RECORD_TELEPROMPTER_SESSION="$SESSION_ID" \
    wf-recorder -o "$1" -r 30 "${audio_args[@]}" -f "$FILE" >"$LOG" 2>&1 &
  pid=$!
  printf '%s %s\n' "$pid" "$SESSION_ID" >"$RECORDER"
}

# Epoch seconds of a segment's start, parsed from its filename timestamp.
segment_start() {
  local ts d t
  ts=$(basename "$1" .mp4); ts=${ts#teleprompter-}   # 2026-07-02_17-06-06
  d=${ts%%_*}; t=${ts#*_}; t=${t//-/:}
  date -d "$d $t" +%s 2>/dev/null
}

# Stitch a multi-segment session (from a dock drop) into ONE continuous video.
# Each gap where the prompter was gone is filled with the frozen last frame of
# the previous segment (+ silence when the session has audio), so the result
# freezes over the drop and keeps going with A/V still in sync. Re-encodes the
# whole session (concat -c copy across freeze clips is too fragile); segments
# are kept next to the stitched file in case anything goes wrong.
stitch_session() {
  local manifest=$1 workdir out list
  workdir=$(mktemp -d "$RUNTIME_DIR/stitch.XXXXXX") || return 1
  mv "$manifest" "$workdir/manifest"
  local segs=()
  while read -r f; do [[ -f $f ]] && segs+=("$f"); done <"$workdir/manifest"
  if ((${#segs[@]} < 2)); then rm -rf "$workdir"; return 0; fi
  out="${segs[0]%.mp4}-stitched.mp4"
  list="$workdir/concat.txt"

  local has_audio=0 acodec=()
  [[ -n $(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "${segs[0]}") ]] \
    && { has_audio=1; acodec=(-c:a aac -b:a 128k); }

  local i=0 seg prev="" prev_start="" start dur gap png
  for seg in "${segs[@]}"; do
    start=$(segment_start "$seg")
    if [[ -n $prev && -n $start && -n $prev_start ]]; then
      dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$prev")
      gap=$((start - prev_start - ${dur%.*}))
      if ((gap > 0)); then
        # Freeze frame: last decodable frame near the end of the previous segment.
        png="$workdir/freeze$i.png"
        ffmpeg -y -v error -sseof -2 -i "$prev" -an -update 1 -frames:v 1 "$png" 2>/dev/null
        [[ -s $png ]] || ffmpeg -y -v error -sseof -10 -i "$prev" -an -update 1 -frames:v 1 "$png" 2>/dev/null
        if [[ -s $png ]]; then
          if ((has_audio)); then
            ffmpeg -y -v error -loop 1 -i "$png" -f lavfi -i anullsrc=r=48000:cl=stereo \
              -t "$gap" -r 30 -c:v libx264 -preset superfast -crf 20 -pix_fmt yuv420p \
              "${acodec[@]}" "$workdir/gap$i.mp4"
          else
            ffmpeg -y -v error -loop 1 -i "$png" \
              -t "$gap" -r 30 -c:v libx264 -preset superfast -crf 20 -pix_fmt yuv420p \
              "$workdir/gap$i.mp4"
          fi
          [[ -s $workdir/gap$i.mp4 ]] && printf "file '%s'\n" "$workdir/gap$i.mp4" >>"$list"
        fi
      fi
    fi
    printf "file '%s'\n" "$seg" >>"$list"
    prev=$seg; prev_start=$start; ((i++))
  done

  notify "󰕧" "Stitching teleprompter session" "${#segs[@]} segments → $(basename "$out")"
  if ffmpeg -y -v error -f concat -safe 0 -i "$list" \
       -vf fps=30 -c:v libx264 -preset superfast -crf 20 -pix_fmt yuv420p \
       "${acodec[@]}" "$out"; then
    notify "󰕧" "Teleprompter session stitched" "$(basename "$out") — segments kept too"
  else
    notify "󰕧" "Stitching failed" "Individual segments are intact in ~/Videos" -u critical
  fi
  rm -rf "$workdir"
}

# End of a session: if a dock drop split it into segments, stitch them in the
# background (re-encoding a long take can run minutes; don't block the toggle).
finish_session() {
  if [[ -f $SEGMENTS ]] && (($(grep -c . "$SEGMENTS") >= 2)); then
    (stitch_session "$SEGMENTS") &
    disown
  else
    rm -f "$SEGMENTS"
  fi
}

# --- Already recording (or waiting to resume)? Stop everything, finalize, tear
# down any audio mix. Kill the watchdog FIRST so it can't restart the recorder. ---
if recorder_alive || watchdog_alive; then
  watchdog_alive && kill "$(<"$WATCHDOG")" 2>/dev/null
  rm -f "$WATCHDOG" "$WAITING"
  stop_recorder
  teardown_audio
  notify "󰓛" "Teleprompter recording stopped" "Saved to ~/Videos"
  finish_session
  exit 0
fi
rm -f "$WATCHDOG" "$RECORDER" "$WAITING" "$SEGMENTS"   # stale files from a crashed run

OUTPUT=$(find_output)
if [[ -z $OUTPUT ]]; then
  notify "󰕧" "Teleprompter not found" "No monitor matching 'Elgato Prom' is connected" -u critical
  exit 1
fi

# --- Audio source menu (mirrors omarchy's screenrecord options). ---
choice=$(omarchy menu select "Record teleprompter" \
  $'󰍭\tNo audio' \
  $'\tMicrophone' \
  $'󰕾\tDesktop audio' \
  $'󰍬\tDesktop + microphone')
[[ -z $choice ]] && exit 0   # menu cancelled

teardown_audio   # clear any stale modules from a previous crashed run

# NOTE: wf-recorder's audio device must be ATTACHED to the flag (--audio=DEVICE).
# The detached form (-a DEVICE) is silently ignored and falls back to "default"
# (the mic), which records silence for desktop capture.
audio_args=()
case "$choice" in
*"No audio") : ;;
*"Microphone")
  audio_args=("--audio=$(pactl get-default-source)") ;;
*"Desktop audio")
  audio_args=("--audio=$(pactl get-default-sink).monitor") ;;
*"Desktop + microphone")
  # wf-recorder records a single device, so mix desktop + mic into a temp null
  # sink and record its monitor. Module IDs are saved for teardown on stop.
  sink=$(pactl get-default-sink); src=$(pactl get-default-source)
  null=$(pactl load-module module-null-sink sink_name=tp_rec sink_properties=device.description=TeleprompterRec)
  lb1=$(pactl load-module module-loopback source="${sink}.monitor" sink=tp_rec latency_msec=40)
  lb2=$(pactl load-module module-loopback source="$src" sink=tp_rec latency_msec=40)
  printf '%s\n' "$lb1" "$lb2" "$null" >"$STATE"   # unload loopbacks before the sink
  audio_args=("--audio=tp_rec.monitor") ;;
esac

# --- Record. ---
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
mkdir -p "$OUTPUT_DIR"

start_recorder "$OUTPUT"
sleep 0.6

if recorder_alive; then
  printf '%s\n' "$FILE" >"$SEGMENTS"
  notify "󰕧" "Teleprompter recording started" "$choice · $(basename "$FILE")"
else
  rm -f "$RECORDER"
  teardown_audio
  notify "󰕧" "Teleprompter recording failed" "See $LOG" -u critical
  exit 1
fi

# --- Watchdog: finalize + auto-resume if the prompter output disappears. Runs
# until toggle-stop kills it (via $WATCHDOG) or the recorder ends on its own. ---
(
  while sleep 3; do
    if ! recorder_alive; then
      # Recorder died on its own (toggle-stop kills this watchdog first, so this
      # is a crash) — clean up and tell the user rather than failing silently.
      teardown_audio
      rm -f "$WATCHDOG" "$RECORDER"
      notify "󰕧" "Teleprompter recording ended unexpectedly" "See $LOG" -u critical
      finish_session
      exit 0
    fi
    [[ -n $(find_output) ]] && continue

    # Output is gone (dock USB drop): the segment so far is intact — finalize it
    # now instead of letting wf-recorder record nothing against a dead output.
    stop_recorder
    touch "$WAITING"
    notify "󰕧" "Prompter disconnected" "Segment saved: $(basename "$FILE") — will resume automatically" -u critical

    OUTPUT=""
    for _ in $(seq 1 120); do   # wait up to ~2 min for the display to return
      OUTPUT=$(find_output)
      [[ -n $OUTPUT ]] && break
      sleep 1
    done
    if [[ -z $OUTPUT ]]; then
      teardown_audio
      rm -f "$WATCHDOG" "$WAITING"
      notify "󰕧" "Teleprompter recording ended" "Prompter did not reconnect within 2 min" -u critical
      finish_session
      exit 1
    fi

    sleep 2   # let the reconnected output settle before capturing
    start_recorder "$OUTPUT"
    sleep 0.6
    if recorder_alive; then
      printf '%s\n' "$FILE" >>"$SEGMENTS"
      rm -f "$WAITING"
      notify "󰕧" "Teleprompter recording resumed" "$(basename "$FILE")"
    else
      teardown_audio
      rm -f "$WATCHDOG" "$RECORDER" "$WAITING"
      notify "󰕧" "Teleprompter resume failed" "See $LOG" -u critical
      finish_session
      exit 1
    fi
  done
) &
printf '%s\n' "$!" >"$WATCHDOG"
disown
