#!/bin/bash

set -euo pipefail

MONITOR_INFO=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1")')
CURRENT_RES=$(echo "$MONITOR_INFO" | jq -r '"\(.width)x\(.height)"')

if [ "$CURRENT_RES" = "1920x1080" ]; then
  hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto-right", scale = 2 })' >/dev/null
  omarchy notification send -g 󰍹 "Recording mode off" "2880x1800 (16:10)"
else
  hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "1920x1080@120", position = "auto-right", scale = 1 })' >/dev/null
  omarchy notification send -g 󰍹 "Recording mode on" "1920x1080 (16:9)"
fi
