#!/bin/bash

# Screenshot the currently focused window without any interaction.
# Grabs the active window geometry directly because Omarchy's screenshot
# wrapper currently supports regions, windows, and full screens, but not the
# already-focused window without interaction.

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
mkdir -p "$OUTPUT_DIR"

SELECTION=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')

[[ -z $SELECTION || $SELECTION == "null,null nullxnull" ]] && exit 0

FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"

grim -g "$SELECTION" "$FILEPATH" || exit 1
wl-copy --type image/png <"$FILEPATH"

printf -v EDIT_COMMAND 'tensaku-edit %q' "$FILEPATH"
omarchy notification send \
  --image "$FILEPATH" \
  --exec "$EDIT_COMMAND" \
  "Screenshot saved to clipboard and file" \
  "Click to edit in Tensaku" \
  -t 10000 || true
